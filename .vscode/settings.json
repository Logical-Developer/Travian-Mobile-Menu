{
  "files.exclude": {
    "**/Backup": true,
    "**/Private-Document": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/Backup": true,
    "**/Private-Document": true
  },
  "files.associations": {
    "*.user.js": "javascript"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.eol": "\n"
}

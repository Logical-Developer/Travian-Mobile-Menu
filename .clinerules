├── .gitignore                          # ← Git ignore
├── LICENSE                             # ← MIT License
├── Backup/                             # ← Old versions (IGNORED by git)
│   └── Travian Mobile Menu-1.2.0.user.js
├── Private-Document/                   # ← Private notes & DOM dumps (IGNORED by git)
